{
  "name": "workbench",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "oxlint --deny-warnings --deny typescript/no-floating-promises apps packages && bash -n deploy.sh infra/*.sh",
    "dev:worker": "npm run dev -w apps/worker",
    "dev:daemon": "npm run dev -w apps/daemon",
    "create:invite": "npm run invite:create -w apps/worker --",
    "create:invite:staging": "npm run invite:create -w apps/worker -- --url https://staging.usebench.dev",
    "hostctl": "bash ./infra/hostctl.sh",
    "hostctl:staging": "WORKBENCH_ENVIRONMENT=staging bash ./infra/hostctl.sh",
    "deploy": "bash ./deploy.sh",
    "deploy:staging": "bash ./deploy.sh --environment staging",
    "deploy:worker": "npm run deploy -w apps/worker",
    "deploy:dry-run": "bash ./deploy.sh --dry-run"
  },
  "devDependencies": {
    "oxlint": "^1.74.0"
  },
  "overrides": {
    "sharp": "^0.35.3"
  }
}

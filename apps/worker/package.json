{
  "name": "@workbench/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:client": "rm -f public/*.js public/*.wasm && esbuild client/ui.tsx client/landing.tsx client/account.tsx client/security.ts client/onboarding.ts client/dashboard.tsx --bundle --format=esm --jsx=automatic --jsx-import-source=react --minify --splitting --outdir=public",
    "predev": "npm run build:client",
    "dev": "wrangler dev",
    "predeploy": "npm run build:client",
    "deploy": "wrangler deploy",
    "types": "wrangler types --env-file /dev/null",
    "typecheck": "npm run types && tsc --noEmit && tsc --noEmit -p client/tsconfig.json",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply workbench --local",
    "db:migrate:remote": "wrangler d1 migrations apply workbench --remote",
    "invite:create": "tsx scripts/generate-invite.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@better-auth/drizzle-adapter": "^1.6.25",
    "@better-auth/passkey": "^1.6.25",
    "@workbench/contract": "*",
    "@worldcoin/idkit": "^4.2.1",
    "@worldcoin/idkit-core": "^4.2.2",
    "better-auth": "^1.6.25",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.7.4",
    "motion": "^12.42.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "esbuild": "^0.28.1",
    "tsx": "^4.23.1",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5",
    "wrangler": "^4.113.0"
  }
}
